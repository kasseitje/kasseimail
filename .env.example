# -- Copy to `.env`. These two identify the Entra ID app registration that kasseimail signs in
#    through. It is a *public* client -- there is no secret here and there must not be one: you
#    sign in once with a device code and the token lands in the cache under your user data dir.
#
#    How to create the registration is in the README, "Setting up the app registration". The one
#    setting people forget: Allow public client flows must be Yes, or Entra refuses the device
#    code with AADSTS7000218.
KASSEIMAIL_TENANT_ID=
KASSEIMAIL_CLIENT_ID=

# -- optional. Where the templates live; defaults to the user data dir (`kasseimail templates path`
#    prints it). Point it at a directory in a repo to keep the mail texts under version control.
# KASSEIMAIL_TEMPLATES=./templates
